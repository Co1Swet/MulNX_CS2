prefix=/opt/ffmpeg-build/ffmpeg_install
exec_prefix=${prefix}
libdir=/opt/ffmpeg-build/ffmpeg_install/lib
includedir=/opt/ffmpeg-build/ffmpeg_install/include

Name: libavcodec
Description: FFmpeg codec library
Version: 63.7.100
Requires: 
Requires.private: libavutil >= 61.5.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -liconv -lm -latomic -lz -lopenh264 -lstdc++ -lgcc -lgcc_eh -lwinpthread -lole32 -luser32
Cflags: -I${includedir}
